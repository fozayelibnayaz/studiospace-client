# --- BetterAuth ---
# Secret used to sign the BetterAuth session cookies
BETTER_AUTH_SECRET=
# Canonical base URL of this Next.js app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
# Public copy for client components
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# --- Backend ---
# Base URL of the Express API (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:5001

# --- Database (shared with the Express server) ---
MONGODB_URI=mongodb://127.0.0.1:27017

# --- Google social login (BetterAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Image upload ---
NEXT_PUBLIC_IMGBB_API_KEY=
